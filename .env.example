# ─── Modèle de configuration PRODUCTION (VPS) ───────────────────────────────
# Copier en .env et remplir. Ne JAMAIS versionner le .env réel.

# « production » active les contrôles stricts : l'application REFUSE de démarrer
# si SECRET_KEY est la valeur par défaut ou si ALLOWED_ORIGINS est absent/« * ».
ENVIRONMENT=production

# Générer une clé unique (à ne jamais réutiliser d'un environnement à l'autre) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL du VPS
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/hr_platform

# URL EXACTE du frontend, sans « / » final. Sert aussi de base aux liens
# d'invitation par email. Plusieurs origines : séparer par des virgules.
ALLOWED_ORIGINS=https://admin.arra-engineering.com

# Durée de validité des sessions (minutes) — 480 = 8 h
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Taille maximale des fichiers téléversés (Mo)
MAX_UPLOAD_MB=10

# ─── IA (peut aussi être saisi dans /rh/parametrage, qui a la priorité) ─────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_PROVIDER=huggingface
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Email (invitations) — optionnel ────────────────────────────────────────
# Sans SMTP, les invitations restent utilisables via un lien copiable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Domaine des emails générés automatiquement
EMAIL_DOMAIN=arra-engineering.com
