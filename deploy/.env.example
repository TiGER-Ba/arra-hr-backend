# ── ARRA ADMIN — variables de production ─────────────────────────────────────
# Copier en « .env » À CÔTÉ du docker-compose.yml, puis remplir.
# Ce fichier ne doit JAMAIS être versionné (il contient des secrets).
#
#   cp .env.example .env && nano .env
#   chmod 600 .env

# ── Adresse publique (sans « / » final) ──────────────────────────────────────
# Sert à trois choses : CORS, base des liens d'invitation par email, et URL de
# l'API compilée dans le frontend.
PUBLIC_URL=https://admin.arra-engineering.com

# ── Base de données (conteneur PostgreSQL dédié) ─────────────────────────────
POSTGRES_DB=arra_admin
POSTGRES_USER=arra_admin
# Générer un mot de passe ALPHANUMÉRIQUE (les caractères spéciaux cassent l'URL) :
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Sécurité ─────────────────────────────────────────────────────────────────
# ⚠️ OBLIGATOIRE : avec ENVIRONMENT=production, l'application REFUSE de démarrer
# si cette clé est absente ou trop courte. Générer une valeur unique :
#   openssl rand -hex 32
SECRET_KEY=

# Taille maximale des fichiers téléversés (Mo)
MAX_UPLOAD_MB=10

# Domaine des emails générés automatiquement (prenom.nom@…)
EMAIL_DOMAIN=arra-engineering.com

# ── IA (facultatif ici : configurable ensuite dans /rh/parametrage) ──────────
# La valeur saisie dans l'interface prend le dessus sur celle-ci.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_PROVIDER=huggingface
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── SMTP ─────────────────────────────────────────────────────────────────────
# À saisir plutôt dans /rh/parametrage (stocké en base, jamais renvoyé en clair).
# Réglages LWS confirmés : mail.arra-engineering.com · port 587 · STARTTLS
